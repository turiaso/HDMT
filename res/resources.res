// Recursos gráficos del escenario de ejemplo, con margen técnico de 8 px. Añade un MAP por cada escenario gráfico.
PALETTE terrain_palette "gfx/terrain_tiles.png"
TILESET terrain_tiles "gfx/terrain_tiles.png" BEST ALL
MAP world_map "gfx/world_map.png" terrain_tiles BEST 0
MAP bridge_map "gfx/bridge_map.png" terrain_tiles BEST 0
MAP bridge_skirmish_map "gfx/bridge_skirmish_map.png" terrain_tiles BEST 0
SPRITE cell_cursor "gfx/cell_cursor.png" 3 3 NONE
SPRITE unit_soldier "gfx/unit_soldier.png" 2 2 NONE
SPRITE unit_scout "gfx/unit_scout.png" 2 2 NONE
SPRITE unit_engineer "gfx/unit_engineer.png" 2 2 NONE
SPRITE unit_tank "gfx/unit_tank.png" 2 2 NONE
SPRITE fog_tile_reservation "gfx/fog_tile.png" 1 1 NONE
MAP ruins_crossing_map "gfx/ruins_crossing_map.png" terrain_tiles BEST 0
